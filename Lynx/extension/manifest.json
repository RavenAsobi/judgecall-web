{
  "name": "Lynx",
  "description": "从 GEM、melee.gg 和 EventLink 提取 TCG 赛事数据，导入 Lynx 平台",
  "icons": {
    "16": "icons/logo_16.png",
    "48": "icons/logo_48.png",
    "128": "icons/logo_128.png"
  },
  "version": "1.0.1",
  "manifest_version": 3,
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/logo_16.png",
      "48": "icons/logo_48.png",
      "128": "icons/logo_128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "*://*.gem.fabtcg.com/*",
    "*://*.lorcana-api.com/*",
    "*://*.melee.gg/*",
    "*://eventlink.wizards.com/*"
  ]
}
