NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_PATH=/var/www/lynx/shared/data/lynx.db

# Generate with: cd server && npm run hash-password
SUPER_PASSWORD_HASH=

# Opaque login sessions expire after this many hours.
SESSION_TTL_HOURS=72

# Comma-separated explicit cross-origin exceptions. Same-origin requests are always allowed.
CORS_ORIGINS=https://lynx.judgecall.net,http://127.0.0.1:8080

